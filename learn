#!/usr/bin/env python3
"""학습할 프로젝트 폴더에서 실행하는 수동 학습 세션 명령."""

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
WORKSPACE = Path(__file__).resolve().parent
sys.path.insert(0, str(WORKSPACE / "scripts"))
import projects


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("--project", help="학습할 프로젝트 경로 또는 projects.json의 ID (기본: 현재 폴더의 Git 루트)")
    selection.add_argument("--concept", action="store_true", help="특정 프로젝트 없이 공통 개념 학습")
    parser.add_argument("--dry-run", action="store_true", help="세션을 열거나 설정을 쓰지 않고 실행 인자 확인")
    parser.add_argument("topic", nargs="*", help="학습할 주제 (생략하면 멘토가 먼저 질문)")
    args = parser.parse_args()
    try:
        codex = shutil.which("codex")
        if not codex:
            raise ValueError("codex 명령을 찾을 수 없습니다. Codex CLI를 PATH에 추가한 뒤 다시 실행하세요.")
        context = {"mode": "concept" if args.concept else "project"}
        if not args.concept:
            config = projects.load(WORKSPACE)
            if args.project in config["projects"]:
                source = projects.resolve(WORKSPACE, args.project)
            else:
                source = Path(args.project).expanduser().resolve(strict=True) if args.project else Path.cwd().resolve()
                if not args.project:
                    git = subprocess.run(["git", "-C", str(source), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
                    if git.returncode == 0:
                        source = Path(git.stdout.strip()).resolve()
            project_id = projects.register(WORKSPACE, source, save=not args.dry_run)
            context.update(project_id=project_id, source_root=str(source))
        context["topic"] = " ".join(args.topic) or "먼저 학습하고 싶은 주제와 현재 이해도를 질문해 줘."
        prompt = (
            "$learning-mentor를 명시적으로 실행해 줘. 학습 기록에는 $obsidian-notes도 사용해 줘.\n"
            "AGENTS.md를 읽고 아래 선택한 대상만 읽기 전용으로 학습한다. 한국어로 질문부터 시작한다.\n"
            "프로젝트 구현이나 다른 채팅 자동 수집은 요청하지 않았다. 다음 JSON은 학습 대상과 주제다.\n"
            + json.dumps(context, ensure_ascii=False)
        )
        argv = [codex, "--cd", str(WORKSPACE), "--sandbox", "workspace-write", prompt]
        if args.dry_run:
            print(json.dumps({"context": context, "argv": argv}, ensure_ascii=False, indent=2))
            return 0
        os.execv(codex, argv)
    except (OSError, ValueError, KeyError, TypeError) as exc:
        parser.exit(2, f"learn: {exc}\n")


if __name__ == "__main__":
    raise SystemExit(main())
